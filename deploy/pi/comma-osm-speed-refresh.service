[Unit]
Description=comma-osm-speed: archive new drives, re-analyze, suggest drives
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/comma-osm-speed
ExecStart=%h/comma-osm-speed/.venv/bin/comma-osm-speed -v refresh
ExecStart=%h/comma-osm-speed/.venv/bin/comma-osm-speed -v recommend
