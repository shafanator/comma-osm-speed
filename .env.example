# Comma Connect — get JWT from https://jwt.comma.ai (sign in with your comma account)
COMMA_JWT=your_comma_jwt_here

# Dongle ID of your Comma 3X (visible in Comma Connect; looks like a 16-hex string)
COMMA_DONGLE_ID=your_16_hex_dongle_id

# Map matcher — Valhalla server. Default is the public OSM-hosted instance.
# For heavy usage, host your own: https://github.com/valhalla/valhalla
VALHALLA_URL=https://valhalla1.openstreetmap.de

# Overpass API (used to read current maxspeed tags)
OVERPASS_URL=https://overpass-api.de/api/interpreter
